# ═══════════════════════════════════════════════════════════════════
#  CBT + Online Classroom Platform — Environment Variables Template
#  Copy this file to .env and fill in your own values.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────────────────────
# Public URL of this server (no trailing slash).  Used to build
# password-reset links that are emailed to admins.
APP_URL=http://localhost:3000
APP_NAME=CBT School

# ── Session ──────────────────────────────────────────────────────
# Set a unique random value of at least 32 characters before production deployment.
# Development may omit this and receive a process-local random secret.
# Production requires a generated unique secret; do not use a sample value.
# SESSION_SECRET=

# ── Database ─────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cbt_db
DB_USER=root
DB_PASSWORD=

# Required when init-db creates the first admin account or admin test scripts run.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Set TRUST_PROXY=true only when one trusted HTTPS reverse proxy sits in front
# of this server. Production session cookies are Secure automatically.
# TRUST_PROXY=false

# ── Email (optional — needed for forgot-password emails) ─────────
# If neither Gmail nor SMTP is configured, reset links are logged
# to the server console (fine for local development).

# "From" address shown in sent emails.
EMAIL_FROM=CBT Admin <noreply@school.org>

# Option A — Gmail with an App Password (recommended for small deployments):
EMAIL_GMAIL_USER=your@gmail.com
EMAIL_GMAIL_APP_PASS=xxxx-xxxx-xxxx-xxxx

# Option B — Generic SMTP (comment out Gmail options and use these instead):
# EMAIL_SMTP_HOST=smtp.example.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false
# EMAIL_SMTP_USER=user@example.com
# EMAIL_SMTP_PASS=password

# ── Rate Limiting ─────────────────────────────────────────────────
# Max forgot-password requests per IP per 15-minute window (default 3).
# Raise to 100 when running automated tests.
PASSWORD_RESET_RATE_LIMIT=3

# Max login attempts per IP per 15-minute window (default 10).
# Set higher (e.g. 1000) when running automated test suites.
LOGIN_RATE_LIMIT=10

# ── LiveKit (optional — needed for live video/audio classrooms) ──
# Sign up at https://livekit.io and create a project to get these.
# Without LiveKit the classroom page loads but video/audio is unavailable.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxxxx
# LIVEKIT_API_SECRET=your_api_secret_here
