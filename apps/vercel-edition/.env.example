# Copy required values into the Vercel project's server-side environment.
# Do not commit .env files or expose these values to browser code.
APP_DEPLOYMENT_TARGET=vercel
APP_URL=https://your-deployment.example
NODE_ENV=production
SESSION_SECRET=
TRUST_PROXY=true

# Provision a dedicated MySQL database for this deployment.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Create a Vercel Blob store and set its server-side read/write token.
BLOB_READ_WRITE_TOKEN=

# Optional email delivery and classroom video configuration.
# EMAIL_FROM=
# EMAIL_SMTP_HOST=
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_SECURE=false
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASS=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
